# Vorlage. NUR Namen, keine Werte.
#
# Fallstrick: echte Schlüssel gehören in .env.local (lokal, gitignored) bzw. in
# die Vercel-Projekteinstellungen — niemals hierher. Diese Datei liegt im
# Repository und ist damit für jeden lesbar, der es klont.
#
#   cp .env.example .env.local   und dort die Werte eintragen.

# ── Pflicht ────────────────────────────────────────────────────────────
# Dachdomain ohne Protokoll und ohne www. Muss zur Domain in Vercel passen,
# sonst zeigen kanonische URLs und Sitemap ins Leere.
NEXT_PUBLIC_SITE_DOMAIN=

# Anthropic. Der Schlüssel des Arbeitskontos, nicht der der Konsole.
ANTHROPIC_API_KEY=
# Optional: überschreibt das Modell aus der Nischen-Config.
ANTHROPIC_MODEL=

# Stripe. Serverseitig der SECRET Key (sk_…), nicht der Publishable Key (pk_…).
# Mit pk_ antwortet Stripe mit 401, und der Fehler sieht aus wie ein
# Konfigurationsproblem an ganz anderer Stelle.
STRIPE_SECRET_KEY=
# Aus dem Webhook-Endpunkt im Stripe-Dashboard (whsec_…).
STRIPE_WEBHOOK_SECRET=

# Preis-IDs je Nische und Preisstufe. Namensschema:
#   STRIPE_PRICE_<NISCHE_IN_GROSSBUCHSTABEN>_<TIER_ID_IN_GROSSBUCHSTABEN>
# Ohne diese IDs funktioniert der Checkout über price_data — für den
# Livebetrieb gehören die IDs hierher, damit Preisänderungen in Stripe
# nachvollziehbar bleiben.
STRIPE_PRICE_HANDWERKERRECHNUNG_BASIS=
STRIPE_PRICE_HANDWERKERRECHNUNG_PLUS=
STRIPE_PRICE_VFE_BASIS=
STRIPE_PRICE_VFE_PLUS=
# Stubs, erst beim Freischalten nötig:
STRIPE_PRICE_LEASING_BASIS=
STRIPE_PRICE_LEASING_PLUS=
STRIPE_PRICE_BEIHILFE_BASIS=
STRIPE_PRICE_BEIHILFE_PLUS=

# ── Zinsreihe für Rechennischen ────────────────────────────────────────
# Wird von lib/data/zinsreihe.ts gelesen und in jeden Bericht geschrieben.
#
# RATE_SERIES_VERIFIED darf erst auf true, wenn die Reihe wirklich geprüft
# ist: Kennung identifiziert, Lizenzbedingungen gelesen, historische
# Monatsstände importiert. Solange sie false ist, blockiert check:niches
# jede Rechennische und der Rechner verweigert in Produktion die Arbeit.
#
# Ohne historische Stände lassen sich zurückliegende Ablösestichtage nicht
# rechnen — und genau die sind der Rückforderungsfall.
RATE_SERIES_ID=
RATE_SERIES_SOURCE=
RATE_SERIES_VERIFIED=

# Upstash Redis. Trägt Ergebnisspeicher, Widerrufsprotokoll und Rate-Limit.
# Ohne diese Werte läuft die Anwendung mit einem Speicher im Prozess — das ist
# nur für die lokale Entwicklung brauchbar, mehrere Lambda-Instanzen teilen
# sich keinen Speicher.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend. Absenderdomain muss dort verifiziert sein.
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_INBOX=

# ── Optional ───────────────────────────────────────────────────────────
# Eigene Verbindung vom Rate-Limit ausnehmen, damit Tests und Demos nicht am
# eigenen Limit hängenbleiben. Komma-getrennt. Drei Formen:
#   2a02:8109:abcd:1234::   IPv6, verglichen über die ersten 64 Bit
#   2a02:8109:abcd::/48     IPv6 mit eigener Präfixlänge
#   84.112.9.7              IPv4, exakt
# Bei IPv6 keine vollständige Adresse eintragen: Anschlüsse rotieren das
# Geräte-Suffix, ein exakter Eintrag passt nach zwei Tagen nicht mehr.
RATE_LIMIT_ALLOWLIST_IPS=

# Salz für den IP-Hash im Widerrufsprotokoll. Einmal setzen und nicht mehr
# ändern — sonst sind alte Protokolle nicht mehr zuordenbar.
IP_HASH_SALT=

# Zusätzliche Senke für die vier Funnel-Ereignisse (POST mit JSON-Body).
EVENT_WEBHOOK_URL=
